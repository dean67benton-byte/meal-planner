{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meal-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-planner",
      "database_id": "ed70ba96-79a9-4152-8930-2762ec8f549e",
      "migrations_dir": "migrations"
    }
  ],
  // SHA-256 of the household link code. The code itself is never committed.
  "vars": { "HOUSEHOLD_KEY_HASH": "3f0a62e0777db3e24892ebb5ea641c626c566d231c11598c53ab27bdb60e7ba4" },
  "observability": { "enabled": true }
}
