{
  "name": "meal-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json && vite build",
    "worker": "wrangler dev",
    "db:local": "wrangler d1 migrations apply meal-planner --local",
    "deploy": "wrangler d1 migrations apply meal-planner --remote && wrangler deploy"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@cloudflare/workers-types": "5.20261021.1",
    "@preact/preset-vite": "2.9.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "wrangler": "4.151.3",
    "zod": "4.6.7"
  }
}
